---
profile: production
offline: false
strict: true
use_default_rules: true
verbosity: 1
exclude_paths:
  - .cache/
  - .venv/
  - collections/
  - tests/output/
# Enable skip_list entries temporarily only with justification, e.g.: [experimental]
skip_list: []
warn_list:
  - experimental
  - jinja[spacing]
mock_modules: []
mock_roles: []
